# ---------------

/site/config/.license
/site/config/config.starterkit.test.php

# Production host-specific config (contains API keys — never commit)
/site/config/config.3.66.136.66.php



# Massive 3D Models (do not track in git, exceeds 100MB)
*.obj
*.mtl
*_diffuse.png
blender/

# Local Vendor scripts
assets/js/vendor/
assets/fonts/*.woff
assets/fonts/*.woff2
assets/fonts/*.ttf

# Minified JS build artifacts — generated by `npm run build:js`, shipped by
# deploy.sh (which runs `npm run build` before rsync). Prod serves these via
# ghAsset(); dev serves the readable sources.
assets/js/*.min.js

# WASM copied out of node_modules by build:js (laz-perf, for the COPC viewer).
assets/wasm/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer dependencies
vendor/
kirby/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
/site/logs/*
!/site/logs/index.html

# PHP / Tools
.phpunit.result.cache
*.log

# Temporary test files
check.php
test.html
lightsail-key.pem

# SSH keys and sensitive server docs
*.pem
sftp.txt

