# Kirby .htaccess
# revision 2023-07-22

# rewrite rules
<IfModule mod_rewrite.c>

# enable awesome urls. i.e.:
# http://yourdomain.com/about-us/team
RewriteEngine on

# Force HTTPS in production. Skip the redirect on local dev (loopback /
# *.test) so Herd / php -S over plain HTTP keeps working. SiteGround sets
# HTTPS=on once the Let's Encrypt cert is in place.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.*\.test)$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# make sure to set the RewriteBase correctly
# if you are running the site in a subfolder;
# otherwise links or the entire site will break.
#
# If your homepage is http://yourdomain.com/mysite,
# set the RewriteBase to:
#
# RewriteBase /mysite

# In some environments it's necessary to
# set the RewriteBase to:
#
# RewriteBase /

# block files and folders beginning with a dot, such as .git
# except for the .well-known folder, which is used for Let's Encrypt and security.txt
RewriteRule (^|/)\.(?!well-known\/) index.php [L]

# block log files at the document root from being served directly
RewriteRule ^.*\.log$ - [F,L]

# block all files in the content folder from being accessed directly
RewriteRule ^content/(.*) index.php [L]

# block all files in the site folder from being accessed directly
RewriteRule ^site/(.*) index.php [L]

# block direct access to Kirby and the Panel sources
RewriteRule ^kirby/(.*) index.php [L]

# ── Protected 3D assets: NO direct /media access ─────────────────────────
# Models + point clouds are delivered only through the visibility-gated
# gh/file route (site/plugins/project-ux), which re-checks the page's
# visibility / share token before streaming. Apache can't see a page's
# visibility, so the published /media copy of a private/link project's model
# was downloadable by anyone who guessed the URL. Hard-deny any direct hit on
# those /media copies; the gh/file route reads the originals from the
# (non-web-served) content dir, so it is unaffected. Header-based "same-origin"
# checks are intentionally NOT used — they're trivially forged.
RewriteRule ^media/.*\.(glb|gltf|obj|mtl|fbx|stl|dae|3ds|drc|ply|pcd|las|laz|e57|xyz|pts)$ - [F,L]
# Plain-text 403 body so Apache does NOT delegate to index.php (which would
# trigger Kirby+Whoops on an already-committed 403 status).
ErrorDocument 403 "403 Forbidden"

# make site links work
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*) index.php [L]

</IfModule>

# pass the Authorization header to PHP
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

# Serve WebAssembly with the correct MIME so the COPC viewer's laz-perf can use
# WebAssembly.instantiateStreaming (without this Apache may send octet-stream/
# text/plain and the browser falls back to a slower arrayBuffer compile).
<IfModule mod_mime.c>
AddType application/wasm .wasm
</IfModule>

# compress text file responses
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE text/javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# set security headers in all responses
<IfModule mod_headers.c>

# serve files as plain text if the actual content type is not known
# (hardens against attacks from malicious file uploads)
Header set Content-Type "text/plain" "expr=-z %{CONTENT_TYPE}"
Header set X-Content-Type-Options "nosniff"

# X-Frame-Options is the legacy anti-clickjacking header but it cannot list
# multiple origins. We use Content-Security-Policy frame-ancestors instead so
# the site can be embedded into govr.eu (Squarespace) while still rejecting
# embedding from anywhere else.
Header always unset X-Frame-Options
Header set Content-Security-Policy "frame-ancestors 'self' https://govr.eu https://*.govr.eu https://*.squarespace.com https://*.sqsp.net;"

Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

# Allow same-origin font/CSS preload to be used cross-origin in iframes
Header set Access-Control-Allow-Origin "*" "expr=%{REQUEST_URI} =~ m#^/assets/fonts/#"

# HSTS: tell browsers to use HTTPS for the next year. Only sent on HTTPS
# requests so it can't bite us during local-loopback HTTP testing.
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"

</IfModule>

# Static asset caching. CSS/JS use a moderate cache so a deploy is reflected
# within a day for returning visitors (no cache-busting query string is added
# by Kirby's css()/js() helpers). Fonts and images are immutable enough to
# get a long cache.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css                    "access plus 1 day"
ExpiresByType application/javascript      "access plus 1 day"
ExpiresByType text/javascript             "access plus 1 day"
ExpiresByType image/svg+xml               "access plus 1 month"
ExpiresByType image/jpeg                  "access plus 1 month"
ExpiresByType image/png                   "access plus 1 month"
ExpiresByType image/webp                  "access plus 1 month"
ExpiresByType image/avif                  "access plus 1 month"
ExpiresByType font/woff                   "access plus 1 year"
ExpiresByType font/woff2                  "access plus 1 year"
ExpiresByType model/gltf-binary           "access plus 1 month"
ExpiresByType model/obj                   "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
# Belt-and-braces Cache-Control for fonts so CDNs/proxies see the freshness rule.
<FilesMatch "\.(woff2?|ttf|otf)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
