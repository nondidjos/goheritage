# Copy this file to ".env" at the project root and fill in real values.
# .env is git-ignored.

# SSH target — Lightsail's default user is "bitnami"
LIGHTSAIL_HOST=bitnami@goheritage.govr.eu

# Path to the .pem file you downloaded from the Lightsail console
# (Account → SSH keys → Download default key, or upload your own).
# Make sure it's chmod 600 before first use.
LIGHTSAIL_KEY=/absolute/path/to/lightsail-default.pem

# Optional override — defaults to Bitnami's standard docroot
# LIGHTSAIL_REMOTE_DIR=/opt/bitnami/apache/htdocs

# Optional: skip "npm run build" if you've just built locally
# SKIP_BUILD=1
