{
  "name": "goheritage",
  "version": "1.0.0",
  "private": true,
  "description": "GoHéritage — 3D heritage visualization platform (Kirby CMS).",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --minify",
    "build:js": "node scripts/build-js.mjs",
    "build": "npm run build:css && npm run build:js",
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --watch"
  },
  "//": "Runtime deps are the tools the model-converter / hotspot-detector plugins shell out to via exec(). They must be installed on the production server. Build-only tools (tailwind, three for local importmap) live in devDependencies.",
  "dependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "obj2gltf": "^3.2.0",
    "sharp-cli": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "copc": "^0.0.8",
    "esbuild": "^0.24.2",
    "laz-perf": "^0.0.7",
    "tailwindcss": "^4.1.18",
    "three": "^0.183.2"
  }
}
